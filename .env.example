# ---------------------------------------------------------------
# Database — PostgreSQL / Supabase (required)
# ---------------------------------------------------------------
# Supabase dashboard > Connect > "Transaction pooler".
#
# Use the POOLER host, not db.<ref>.supabase.co — the direct host resolves to
# IPv6 only, which Vercel's functions cannot reach.
#
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------
# Admin sessions (required)
# ---------------------------------------------------------------
# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------
# Site (recommended)
# ---------------------------------------------------------------
# Your live URL. Used by the sitemap and page metadata.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# ---------------------------------------------------------------
# Enquiry form (optional)
# ---------------------------------------------------------------
# Without these the contact form falls back to opening the visitor's mail client.
RESEND_API_KEY=""
ENQUIRY_TO="info@mgimst.org"
ENQUIRY_FROM="website@your-verified-domain.org"

# ---------------------------------------------------------------
# Footer social links (optional)
# ---------------------------------------------------------------
# Only profiles with a URL are rendered, so no dead icons appear.
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_TWITTER=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
