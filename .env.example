# ---------------------------------------------------------------
# Database (required for the admin portal and result verification)
# ---------------------------------------------------------------
# MongoDB Atlas: Database > Connect > Drivers > copy the connection string.
# URL-encode any special characters in the password (@ becomes %40, and so on).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mgimst"

# ---------------------------------------------------------------
# Admin sessions (required)
# ---------------------------------------------------------------
# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------
# Enquiry form (optional)
# ---------------------------------------------------------------
# Without these the contact form falls back to opening the visitor's mail client.
RESEND_API_KEY=""
ENQUIRY_TO="info@mgimst.org"
ENQUIRY_FROM="website@your-verified-domain.org"
